@{
    ViewData["Title"] = "Dashboard";
    var userName = ViewData["UserName"] as string;
    var id = ViewData["UserId"] as string;
    var games = ViewData["Games"] as List<Game>;
}

<h1>Welcome, @userName!</h1>

@if (TempData["Message"] != null)
{
    <p class="alert alert-success">@TempData["Message"]</p>
}

@if (TempData["Error"] != null)
{
    <p class="alert alert-danger">@TempData["Error"]</p>
}

<h2>Upcoming Games</h2>

@if (games != null && games.Count > 0)
{
    <div class="list-group">
        @foreach (var game in games)
        {
            <div class="list-group-item">
                <h5>@game.Sport - @game.Location</h5>
                <p><strong>Start:</strong> @game.StartDate.ToString("f")</p>
                <p><strong>End:</strong> @game.EndDate.ToString("f")</p>
                <p><strong>Capacity:</strong> @game.Capacity</p>
                <p><strong>Event ID:</strong> @game.EventId</p>
                <p><strong>Active:</strong> @(game.Active ? "Yes" : "No")</p>
            </div>
        }
    </div>
}
else
{
    <p>No upcoming games available.</p>
}